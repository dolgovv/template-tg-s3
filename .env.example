# Telegram bot token — get it from @BotFather
BOT_TOKEN=

# Optional: HTTP/HTTPS proxy URL (leave empty if not needed)
# Format: http://user:password@host:port
PROXY_URL=

# Website name shown in the welcome message
WEBSITE_NAME=My Website

# Comma-separated list of admin Telegram IDs
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# MinIO / S3 storage
# Endpoint URL of your MinIO instance
# Local: http://localhost:9000
# Inside Docker network: http://minio:9000
S3_ENDPOINT=http://localhost:9000

# AWS region — MinIO ignores this but the SDK requires a value
S3_REGION=us-east-1

# MinIO service account access key
S3_BOT_NAME=

# MinIO service account secret key
S3_BOT_PASS=

# Bucket name to work with
S3_BUCKET=

# Root user name
S3_ADMIN=

# Root user name
S3_PASSWORD=

# Telegram bot user name
S3_BOT_NAME=

# Telegram bot user password
S3_BOT_PASS=
