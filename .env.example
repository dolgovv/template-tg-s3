# ─── Telegram ─────────────────────────────────────────────────────────────────

# Telegram bot token — get it from @BotFather
BOT_TOKEN=

# Comma-separated list of admin Telegram IDs
# Example: ADMIN_IDS=123456789,987654321
ADMIN_IDS=

# Website name shown in the welcome message
WEBSITE_NAME=Your Website`s Name

# Optional: HTTP/HTTPS proxy URL (leave empty if not needed)
# Format: http://user:password@host:port
PROXY_URL=

# Optional: folder for logs (default: ./logs)
LOG_PATH=

# ─── S3 storage ───────────────────────────────────────────────────────────────

# S3 API URL
#   Bundled Garage (docker compose --profile garage): http://garage:3900
#   S3 on the same machine, bot outside Docker:      http://localhost:3900
#   Cloud provider:  its endpoint, e.g. https://storage.yandexcloud.net
#   AWS S3:          leave empty
S3_ENDPOINT=http://garage:3900

# Region. Garage: the s3_region from docker/garage.toml ("garage")
# MinIO accepts any value. Cloud: your bucket's region
S3_REGION=garage

# Access key pair
# With bundled Garage the key is created from these values on first start.
# Garage requires this format, generate with:
#   echo "GK$(openssl rand -hex 16)"   → S3_ACCESS_KEY_ID
#   openssl rand -hex 32               → S3_SECRET_ACCESS_KEY
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bucket name (created automatically with bundled Garage)
S3_BUCKET=tg-bot

# true:  http://host/bucket/key  (Garage, MinIO, most self-hosted storages)
# false: http://bucket.host/key  (AWS and providers requiring virtual-hosted style)
S3_FORCE_PATH_STYLE=true

# Folder inside the bucket the bot starts from, e.g. site/
# Leave empty to start from the bucket root
S3_ROOT_PREFIX=

# ─── Bundled Garage only ──────────────────────────────────────────────────────

# Internal Garage secret, generate with: openssl rand -hex 32
GARAGE_RPC_SECRET=
